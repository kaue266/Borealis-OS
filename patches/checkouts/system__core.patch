+// Opt-in diagnostic logging to the existing persistent RAM ring. No disk mount
+// or partition write is performed. The descriptor closes on stage transition.
+static void BorealisFirstStageTrace(const std::string& cmdline) {
+    bool enabled = false;
+    for (const auto& token : android::base::Split(cmdline, " ")) {
+        if (token == "androidboot.borealis_boot_trace=1") enabled = true;
+    }
+    std::string marker;
+    if (android::base::ReadFileToString("/borealis_boot_trace", &marker, false) && marker == "1\n") enabled = true;
+    if (!enabled) return;
+    setenv("BOREALIS_BOOT_TRACE", "1", 1);
+    SetFatalRebootTarget(std::string("recovery"));
+
+    std::string device;
+    unsigned int major_id = 0, minor_id = 0;
+    if (!android::base::ReadFileToString("/sys/class/pmsg/pmsg0/dev", &device) ||
+        sscanf(device.c_str(), "%u:%u", &major_id, &minor_id) != 2) return;
+    const dev_t number = makedev(major_id, minor_id);
+    if (mknod("/dev/pmsg0", S_IFCHR | 0600, number) && errno != EEXIST) return;
+    struct stat state {};
+    if (lstat("/dev/pmsg0", &state) || !S_ISCHR(state.st_mode) || state.st_rdev != number) return;
+    const int fd = open("/dev/pmsg0", O_WRONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return;
+    android::base::SetLogger([fd](android::base::LogId id, android::base::LogSeverity severity,
+                                 const char* tag, const char* file, unsigned int line,
+                                 const char* message) {
+        const int saved_errno = errno;
+        android::base::KernelLogger(id, severity, tag, file, line, message);
+        if (severity >= android::base::INFO) {
+            char record[2048];
+            const int count = snprintf(record, sizeof(record), "BOREALIS_INIT_TRACE [%d] %s:%u %s\n",
+                                       static_cast<int>(severity), file ? file : "init", line,
+                                       message ? message : "");
+            if (count > 0) {
+                const size_t length = count < static_cast<int>(sizeof(record))
+                                          ? count : sizeof(record) - 1;
+                size_t position = 0;
+                while (position < length) {
+                    const ssize_t result = write(fd, record + position, length - position);
+                    if (result > 0) position += result;
+                    else if (result < 0 && errno == EINTR) continue;
+                    else break;
+                }
+            }
+        }
+        errno = saved_errno;
+    });
+    LOG(INFO) << "BOREALIS_INIT_TRACE first-stage capture enabled; RAM only";
+}

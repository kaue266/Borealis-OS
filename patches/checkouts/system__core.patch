+// Preserve explicitly requested boot diagnostics across init's exec boundaries.
+// The existing pmsg device is a RAM ring, not a physical storage partition.
+static void BorealisStageTrace(char** argv) {
+    const char* enabled = getenv("BOREALIS_BOOT_TRACE");
+    if (!enabled || strcmp(enabled, "1")) return;
+    SetFatalRebootTarget(std::string("recovery"));
+    std::string device;
+    unsigned int major_id = 0, minor_id = 0;
+    if (!android::base::ReadFileToString("/sys/class/pmsg/pmsg0/dev", &device) ||
+        sscanf(device.c_str(), "%u:%u", &major_id, &minor_id) != 2) return;
+    struct stat state {};
+    if (lstat("/dev/pmsg0", &state) || !S_ISCHR(state.st_mode) ||
+        state.st_rdev != makedev(major_id, minor_id)) return;
+    const int fd = open("/dev/pmsg0", O_WRONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return;
+    android::base::SetLogger([fd](android::base::LogId id, android::base::LogSeverity severity,
+                                 const char* tag, const char* file, unsigned int line,
+                                 const char* message) {
+        const int saved_errno = errno;
+        android::base::KernelLogger(id, severity, tag, file, line, message);
+        if (severity >= android::base::INFO) {
+            char record[2048];
+            const int count = snprintf(record, sizeof(record), "BOREALIS_STAGE_TRACE [%d] %s:%u %s\n",
+                                      static_cast<int>(severity), file ? file : "init", line,
+                                      message ? message : "");
+            if (count > 0) {
+                const size_t length = std::min(static_cast<size_t>(count), sizeof(record) - 1);
+                size_t position = 0;
+                while (position < length) {
+                    const ssize_t result = write(fd, record + position, length - position);
+                    if (result > 0) position += result;
+                    else if (result < 0 && errno == EINTR) continue;
+                    else break;
+                }
+            }
+        }
+        errno = saved_errno;
+    });
+    LOG(INFO) << "BOREALIS_STAGE_TRACE entered " << (argv && argv[1] ? argv[1] : "init");
+}

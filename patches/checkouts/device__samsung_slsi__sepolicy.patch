diff --git a/common/public/file.te b/common/public/file.te
index 9da7f5c..fb482e6 100644
--- a/common/public/file.te
+++ b/common/public/file.te
@@ -1,7 +1,7 @@
 # file.te
 
 ### DATA
-type zram_data_file, file_type, data_file_type, core_data_file_type;
+# zram_data_file is owned by the Android platform (mmd_setup.te).
 
 ### SYSFS
 type sysfs_battery_writable, sysfs_type, rw_fs_type, fs_type;
diff --git a/common/vendor/hal_lineage_health_default.te b/common/vendor/hal_lineage_health_default.te
index 7dd6149..94fb12c 100644
--- a/common/vendor/hal_lineage_health_default.te
+++ b/common/vendor/hal_lineage_health_default.te
@@ -1,3 +1,12 @@
+# Original Lineage implementation domain; Samsung node permissions follow.
+type hal_lineage_health_default, domain;
+hal_server_domain(hal_lineage_health_default, hal_lineage_health)
+
+type hal_lineage_health_default_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(hal_lineage_health_default)
+
+binder_call(hal_lineage_health_default, servicemanager)
+
 allow hal_lineage_health_default sysfs_battery:dir r_dir_perms;
 allow hal_lineage_health_default sysfs_battery_writable:file rw_file_perms;
 

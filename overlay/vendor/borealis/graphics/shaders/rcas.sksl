// Copyright (c) 2021 Advanced Micro Devices, Inc. See ../LICENSE-FSR.txt.
// Safe denominators handle solid black/white; noise attenuation is enabled.
uniform shader inputImage;
uniform float strength;
half4 main(float2 p) {
    float3 b=float3(inputImage.eval(p+float2(0,-1)).rgb);
    float3 d=float3(inputImage.eval(p+float2(-1,0)).rgb);
    float4 center=float4(inputImage.eval(p)); float3 e=center.rgb;
    float3 f=float3(inputImage.eval(p+float2(1,0)).rgb);
    float3 h=float3(inputImage.eval(p+float2(0,1)).rgb);
    float3 low=min(min(b,d),min(f,h)), high=max(max(b,d),max(f,h));
    float3 hitMin=min(low,e)/max(4*high,float3(0.00001));
    float3 hitMax=(1-max(high,e))/min(4*low-4,float3(-0.00001));
    float3 lobes=max(-hitMin,hitMax);
    float lob=max(-0.1875,min(max(max(lobes.r,lobes.g),lobes.b),0.0))*strength;
    float lb=b.g+0.5*(b.r+b.b), ld=d.g+0.5*(d.r+d.b);
    float le=e.g+0.5*(e.r+e.b), lf=f.g+0.5*(f.r+f.b), lh=h.g+0.5*(h.r+h.b);
    float range=max(max(max(lb,ld),max(le,lf)),lh)-min(min(min(lb,ld),min(le,lf)),lh);
    float noise=clamp(abs(0.25*(lb+ld+lf+lh)-le)/max(range,0.00001),0.0,1.0);
    lob*=1-0.5*noise;
    return half4(clamp((lob*(b+d+f+h)+e)/(4*lob+1),0.0,1.0),center.a);
}

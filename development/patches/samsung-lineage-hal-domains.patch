--- a/device/samsung_slsi/sepolicy/common/vendor/hal_lineage_health_default.te
+++ b/device/samsung_slsi/sepolicy/common/vendor/hal_lineage_health_default.te
@@ -1,3 +1,12 @@
+# Original Lineage implementation domain; Samsung node permissions follow.
+type hal_lineage_health_default, domain;
+hal_server_domain(hal_lineage_health_default, hal_lineage_health)
+
+type hal_lineage_health_default_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(hal_lineage_health_default)
+
+binder_call(hal_lineage_health_default, servicemanager)
+
 allow hal_lineage_health_default sysfs_battery:dir r_dir_perms;
 allow hal_lineage_health_default sysfs_battery_writable:file rw_file_perms;
 
